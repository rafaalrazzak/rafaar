---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import NowPlaying from '@/components/NowPlaying.astro';
import Tags from '@/components/Tags.astro';
import Avatar from '@/components/Avatar.astro';
import { RESUME_DATA } from '@/data/resume-data';
import { durationSince, startYear } from '@/lib/duration';
import { CALENDAR, LEVEL_OPACITY, WEEKDAY_LABELS, describeDay, fetchContributions, monthLabels } from '@/lib/github';
import siteMetadata from '@/data/site-metadata';

const {
  name,
  role,
  location,
  about,
  email,
  social,
  elsewhere,
  work,
  projects,
  education,
  stack,
} = RESUME_DATA;

const github = await fetchContributions('rafaalrazzak');
const githubMonths = github ? monthLabels(github.days) : [];

// Structured data, built from the same source as the page so the two cannot
// disagree. Gives search engines the entity behind the site rather than leaving
// them to infer it from prose.
const personId = `${siteMetadata.SITE_URL}/#person`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name,
  url: siteMetadata.SITE_URL,
  image: new URL(siteMetadata.SITE_PHOTO, siteMetadata.SITE_URL).href,
  jobTitle: role,
  description: about,
  email: `mailto:${email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bogor',
    addressCountry: 'ID',
  },
  sameAs: social.map((link) => link.url),
  worksFor: work.map((job) => ({
    '@type': 'Organization',
    name: job.company,
    url: job.url,
  })),
  alumniOf: education.map((item) => ({
    '@type': 'EducationalOrganization',
    name: item.school,
  })),
  knowsAbout: stack.flatMap((entry) => entry.items),
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteMetadata.SITE_URL}/#website`,
      url: siteMetadata.SITE_URL,
      name: siteMetadata.SITE_NAME,
      description: siteMetadata.SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteMetadata.SITE_URL}/#profile`,
      url: siteMetadata.SITE_URL,
      name: `${name} — ${role}`,
      isPartOf: { '@id': `${siteMetadata.SITE_URL}/#website` },
      mainEntity: { '@id': personId },
    },
    person,
  ],
};

// Projects beyond this count sit behind "Show all"; the printed CV lists them.
const FEATURED = 6;

const contact = [
  { name: 'Email', url: `mailto:${email}`, icon: 'mail' as const },
  ...social,
];

// Paper has no links to click, so the printed CV spells out the addresses
// that matter to a reader and drops the purely social ones.
const PRINT_CONTACT = new Set(['GitHub', 'LinkedIn']);
const printContact = [
  email,
  siteMetadata.SITE_URL,
  ...social.filter((link) => PRINT_CONTACT.has(link.name)).map((link) => link.url),
].map((value) => value.replace(/^https?:\/\/(www\.)?/, ''));
---

<Layout>
  <div class="space-y-16 print:space-y-6">
    <!-- Intro -->
    <section class="space-y-6 print:space-y-3" data-reveal>
      <div class="flex items-center gap-4">
        <Avatar src="/rafaar-formal.jpg" />
        <div class="min-w-0">
          <h1 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.03em] sm:text-[2rem] print:text-3xl">
            {name}
          </h1>
          <p class="text-muted-foreground text-[0.95rem]">
            {role} · {location}<span
              data-local-time
              class="text-muted-foreground/70 tabular-nums print:hidden"></span>
          </p>
        </div>
      </div>

      <p class="text-foreground/85 max-w-[38rem] text-base leading-relaxed print:max-w-none print:text-[10.5pt]">
        {about}
      </p>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm print:hidden">
        {
          contact.map((link) => (
            <li class="inline-flex items-center gap-1">
              <a
                href={link.url}
                target={link.url.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.url.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
                class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5"
              >
                <Icon name={link.icon} class="size-[0.95rem]" />
                {link.name}
              </a>
              {link.icon === 'mail' && (
                <button
                  type="button"
                  data-copy-email={email}
                  class="text-muted-foreground/70 hover:text-foreground hover:bg-muted rounded-md px-1.5 py-0.5 text-xs transition-colors"
                  aria-label={`Copy ${email}`}
                >
                  Copy
                </button>
              )}
            </li>
          ))
        }
      </ul>

      <p class="text-foreground/80 hidden text-[9.5pt] print:block">
        {printContact.join('  ·  ')}
      </p>

      <NowPlaying />
    </section>

    <!-- Work -->
    <Section title="Work" id="work">
      <div class="-mx-3 space-y-1 print:mx-0 print:space-y-0" data-stagger>
        {
          work.map((job) => (
            <article class="hover:bg-muted/70 flex gap-4 rounded-2xl p-3 transition-colors duration-200 print:gap-0 print:rounded-none print:p-0 print:py-2">
              {job.logo && (
                <img
                  src={job.logo}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                  class="border-border/80 mt-0.5 size-9 shrink-0 rounded-lg border bg-white object-contain p-1 print:hidden"
                />
              )}
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="text-[0.95rem] font-semibold">
                    <a
                      href={job.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-primary"
                    >
                      {job.company}
                    </a>
                  </h3>
                  <span class="text-muted-foreground text-sm tabular-nums">
                    {startYear(job.startDate)} – {job.end ?? 'Present'}
                    <span
                      class="text-muted-foreground/60"
                      data-duration-since={job.endDate ? undefined : job.startDate}
                    >
                      {(() => {
                        const elapsed = durationSince(job.startDate, job.endDate);
                        return elapsed && ` · ${elapsed}`;
                      })()}
                    </span>
                  </span>
                </div>
                <p class="text-muted-foreground text-sm">
                  {job.role}
                  {job.mode && <> · {job.mode}</>}
                </p>
                <p class="text-foreground/80 mt-2.5 text-sm leading-relaxed print:mt-1">
                  {job.description}
                </p>
                {job.tags && job.tags.length > 0 && <Tags tags={job.tags} />}
              </div>
            </article>
          ))
        }
      </div>
    </Section>

    <!-- Projects -->
    <Section title="Projects" id="projects">
      <div class="grid gap-x-5 gap-y-9 sm:grid-cols-2 print:grid-cols-2 print:gap-y-4" data-stagger>
        {
          projects.map((project, i) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              data-extra={i >= FEATURED ? '' : undefined}
              class:list={[
                'group',
                i >= FEATURED ? 'hidden' : 'block',
                i >= FEATURED && !project.hideInPrint && 'print:block',
                project.hideInPrint && 'print:hidden',
              ]}
            >
              {project.thumbnail && (
                <div class="bg-muted border-border/80 mb-3 aspect-[1200/630] overflow-hidden rounded-xl border print:hidden">
                  <img
                    src={project.thumbnail}
                    alt=""
                    width="1200"
                    height="630"
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover object-top transition-transform duration-700 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <h3 class="group-hover:text-primary inline-flex items-center gap-1 text-[0.95rem] font-semibold">
                {project.title}
                <Icon
                  name="arrow-up-right"
                  class="size-3.5 opacity-0 transition-opacity group-hover:opacity-70"
                />
              </h3>
              <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
                {project.description}
              </p>
              {project.tags && project.tags.length > 0 && <Tags tags={project.tags} />}
            </a>
          ))
        }
      </div>
      {
        projects.length > FEATURED && (
          <button
            type="button"
            data-show-more
            aria-expanded="false"
            class="border-border/80 text-muted-foreground hover:text-foreground hover:bg-muted mt-8 inline-flex h-9 items-center rounded-lg border px-3.5 text-sm font-medium transition-colors print:hidden"
          >
            Show all {projects.length} projects
          </button>
        )
      }
    </Section>

    <!-- Education -->
    <Section title="Education" id="education">
      {
        education.map((item) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <div>
              <h3 class="text-[0.95rem] font-semibold">{item.school}</h3>
              <p class="text-muted-foreground text-sm">{item.degree}</p>
            </div>
            <span class="text-muted-foreground text-sm tabular-nums">
              {item.start} – {item.end}
            </span>
          </div>
        ))
      }
    </Section>

    <!-- Stack -->
    <Section title="Stack" id="stack">
      <dl class="space-y-2.5 text-sm print:space-y-1" data-stagger>
        {
          stack.map((entry) => (
            <div class="grid gap-0.5 sm:grid-cols-[7rem_1fr] sm:gap-4">
              <dt class="text-muted-foreground">{entry.group}</dt>
              <dd class="text-foreground/85">{entry.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <!-- GitHub -->
    {
      github && (
        <Section title="GitHub" id="github" class="print:hidden">
          <div class="space-y-3">
            <div class="relative">
              <div class="-mx-1 overflow-x-auto px-1">
                <svg
                  data-contribution-grid
                  role="img"
                  aria-label={`${github.total.toLocaleString('en-US')} contributions in the last year`}
                  width={CALENDAR.weekdayLabelWidth + github.weeks * CALENDAR.step - (CALENDAR.step - CALENDAR.cell)}
                  height={CALENDAR.monthLabelHeight + CALENDAR.rows * CALENDAR.step - (CALENDAR.step - CALENDAR.cell)}
                  class="text-primary"
                >
                  <g
                    fill="currentColor"
                    class="text-muted-foreground"
                    font-size="9"
                    data-contribution-months
                  >
                    {githubMonths.map((month) => (
                      <text x={CALENDAR.weekdayLabelWidth + month.week * CALENDAR.step} y={CALENDAR.monthLabelHeight - 4}>
                        {month.label}
                      </text>
                    ))}
                  </g>
                  <g fill="currentColor" class="text-muted-foreground" font-size="9">
                    {WEEKDAY_LABELS.map(({ weekday, label }) => (
                      <text x="0" y={CALENDAR.monthLabelHeight + weekday * CALENDAR.step + CALENDAR.cell}>
                        {label}
                      </text>
                    ))}
                  </g>
                  <g data-contribution-days>
                    {github.days.map((day) => (
                      <rect
                        x={CALENDAR.weekdayLabelWidth + day.week * CALENDAR.step}
                        y={CALENDAR.monthLabelHeight + day.weekday * CALENDAR.step}
                        width={CALENDAR.cell}
                        height={CALENDAR.cell}
                        rx="2"
                        fill="currentColor"
                        opacity={LEVEL_OPACITY[day.level] ?? LEVEL_OPACITY[0]}
                        data-tip={describeDay(day)}
                      />
                    ))}
                  </g>
                </svg>
              </div>
              <div
                data-contribution-tooltip
                role="tooltip"
                hidden
                class="border-border bg-card text-foreground pointer-events-none absolute z-10 -translate-x-1/2 -translate-y-full rounded-md border px-2 py-1 text-xs whitespace-nowrap"
              />
            </div>

            <p class="text-muted-foreground text-sm">
              <span class="text-foreground font-medium tabular-nums" data-contribution-total>
                {github.total.toLocaleString('en-US')}
              </span>{' '}
              contributions in the last year, over{' '}
              <span class="text-foreground font-medium tabular-nums" data-contribution-active>
                {github.activeDays}
              </span>{' '}
              active days. Counts private and organisation work.
            </p>
          </div>
        </Section>
      )
    }

    <!-- Elsewhere -->
    <Section title="Elsewhere" id="elsewhere" class="print:hidden">
      <ul class="space-y-2 text-sm" data-stagger>
        {
          elsewhere.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2"
              >
                <span class="group-hover:text-primary font-medium">{link.name}</span>
                {link.note && <span class="text-muted-foreground">{link.note}</span>}
                <Icon
                  name="arrow-up-right"
                  class="text-muted-foreground size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </Section>
  </div>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  />
</Layout>

<script>
  // The contribution figures are baked in at build time. Refresh them from the
  // same-origin proxy, which reaches GitHub server-side - the browser cannot,
  // as GitHub's calendar sends no CORS headers. Any failure leaves the
  // build-time values in place.
  import { CALENDAR, LEVEL_OPACITY, describeDay, monthLabels, type Contributions } from '@/lib/github';

  const grid = document.querySelector<SVGSVGElement>('[data-contribution-grid]');
  const daysGroup = document.querySelector<SVGGElement>('[data-contribution-days]');
  const monthsGroup = document.querySelector<SVGGElement>('[data-contribution-months]');
  const totalEl = document.querySelector<HTMLElement>('[data-contribution-total]');
  const activeEl = document.querySelector<HTMLElement>('[data-contribution-active]');

  if (grid && daysGroup && monthsGroup && totalEl && activeEl) {
    const { cell, step, rows, monthLabelHeight, weekdayLabelWidth } = CALENDAR;
    const NS = 'http://www.w3.org/2000/svg';

    try {
      const res = await fetch('/api/contributions');
      if (res.ok) {
        const data = (await res.json()) as Contributions;

        // A deploy leaves the edge function - and its hour-long cache - a
        // version behind this page for a while. Payloads from before per-day
        // counts existed would strip the numbers out of every tooltip, so bail
        // to the catch below and keep what the build rendered.
        if (data.days.some((day) => typeof day.count !== 'number')) {
          throw new Error('contribution payload predates per-day counts');
        }

        totalEl.textContent = data.total.toLocaleString('en-US');
        activeEl.textContent = String(data.activeDays);

        grid.setAttribute('width', String(weekdayLabelWidth + data.weeks * step - (step - cell)));
        grid.setAttribute('height', String(monthLabelHeight + rows * step - (step - cell)));
        grid.setAttribute(
          'aria-label',
          `${data.total.toLocaleString('en-US')} contributions in the last year`,
        );

        const nextDays = document.createDocumentFragment();
        for (const day of data.days) {
          const rect = document.createElementNS(NS, 'rect');
          rect.setAttribute('x', String(weekdayLabelWidth + day.week * step));
          rect.setAttribute('y', String(monthLabelHeight + day.weekday * step));
          rect.setAttribute('width', String(cell));
          rect.setAttribute('height', String(cell));
          rect.setAttribute('rx', '2');
          rect.setAttribute('fill', 'currentColor');
          rect.setAttribute('opacity', String(LEVEL_OPACITY[day.level] ?? LEVEL_OPACITY[0]));
          rect.setAttribute('data-tip', describeDay(day));
          nextDays.append(rect);
        }
        daysGroup.replaceChildren(nextDays);

        const nextMonths = document.createDocumentFragment();
        for (const month of monthLabels(data.days)) {
          const text = document.createElementNS(NS, 'text');
          text.setAttribute('x', String(weekdayLabelWidth + month.week * step));
          text.setAttribute('y', String(monthLabelHeight - 4));
          text.textContent = month.label;
          nextMonths.append(text);
        }
        monthsGroup.replaceChildren(nextMonths);
      }
    } catch {
      // Keep what the build rendered.
    }
  }
</script>

<script>
  // Hover tooltip for the contribution grid. Every cell carries its own label
  // in data-tip - rendered at build time and rewritten by the refresh above -
  // so this only has to position and show it. Kept in its own script so the
  // tooltip still works when the refresh bails out.
  const tip = document.querySelector<HTMLElement>('[data-contribution-tooltip]');
  const frame = tip?.parentElement;
  const days = document.querySelector<SVGGElement>('[data-contribution-days]');

  if (tip && frame && days) {
    const hide = () => {
      tip.hidden = true;
    };

    days.addEventListener('pointerover', (event) => {
      const cell = (event.target as Element).closest('rect');
      const label = cell?.getAttribute('data-tip');
      if (!cell || !label) return hide();

      tip.textContent = label;
      tip.hidden = false;

      // Both boxes are viewport-relative, so this stays correct however far the
      // calendar has been scrolled sideways on narrow screens.
      const cellBox = cell.getBoundingClientRect();
      const frameBox = frame.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const x = cellBox.left - frameBox.left + cellBox.width / 2;

      tip.style.left = `${Math.min(Math.max(x, half), frameBox.width - half)}px`;
      tip.style.top = `${cellBox.top - frameBox.top - 6}px`;
    });

    // Bound to the frame, not the grid: cells sit 3px apart, and leaving the
    // group on every gap crossing would make the bubble flicker.
    frame.addEventListener('pointerleave', hide);
    // The grid scrolls inside its own container, which would leave the bubble
    // stranded next to the wrong day.
    document.addEventListener('scroll', hide, { capture: true, passive: true });
  }
</script>

<script>
  // The page is static, so the baked duration is only correct as of the last
  // build. Recompute on load using the same formatter the server used.
  import { durationSince } from '@/lib/duration';

  for (const el of document.querySelectorAll<HTMLElement>('[data-duration-since]')) {
    const start = el.dataset.durationSince;
    if (!start) continue;

    const elapsed = durationSince(start);
    const next = elapsed ? ` · ${elapsed}` : '';
    if (next !== el.textContent) el.textContent = next;
  }
</script>

<script>
  // Small, progressive interactions. Without JS the page is complete: every
  // section is visible and all projects stay reachable through print.

  // Local time in Bogor next to the location.
  const clock = document.querySelector<HTMLElement>('[data-local-time]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Jakarta',
    });
    const tick = () => {
      clock.textContent = ` · ${fmt.format(new Date())} local`;
    };
    tick();
    setInterval(tick, 30_000);
  }

  // Copy email with inline confirmation.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }

  // Reveal the rest of the projects.
  const more = document.querySelector<HTMLButtonElement>('[data-show-more]');
  if (more) {
    const label = more.textContent?.trim() ?? '';
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll<HTMLElement>('[data-extra]').forEach((card, i) => {
        card.classList.toggle('hidden', !open);
        card.classList.toggle('block', open);
        if (open) {
          card.style.setProperty('--i', String(i));
          card.classList.remove('enter');
          void card.offsetWidth;
          card.classList.add('enter');
        }
      });
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? 'Show fewer' : label;
      if (!open) document.getElementById('projects')?.scrollIntoView({ block: 'start' });
    });
  }

  // Fade sections in as they enter the viewport. The observer reports every
  // target once on start; if it never does (a background tab, a renderer that
  // does not paint), show everything rather than leave sections hidden.
  const revealTargets = document.querySelectorAll('[data-reveal]');
  let observed = false;
  setTimeout(() => {
    if (!observed) revealTargets.forEach((el) => el.classList.add('is-visible'));
  }, 3000);

  const reveal = new IntersectionObserver(
    (entries) => {
      observed = true;
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.querySelectorAll<HTMLElement>('[data-stagger]').forEach((list) => {
          [...list.children].forEach((child, i) =>
            (child as HTMLElement).style.setProperty('--i', String(Math.min(i, 8))),
          );
        });
        entry.target.classList.add('is-visible');
        reveal.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  revealTargets.forEach((el) => reveal.observe(el));
</script>
