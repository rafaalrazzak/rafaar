---
import ThemeToggle from '@/components/ThemeToggle.astro';
import Icon from '@/components/Icon.astro';
import { RESUME_DATA } from '@/data/resume-data';
---

<header
  class="print:hidden bg-background/80 sticky top-0 z-40 border-b border-border/70 backdrop-blur"
>
  <div class="mx-auto flex h-14 w-full max-w-3xl items-center justify-between px-6">
    <a
      href="/"
      class="text-foreground hover:text-primary font-display text-base font-semibold tracking-tight"
    >
      {RESUME_DATA.name}
    </a>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-print-page
        class="text-muted-foreground hover:bg-muted hover:text-foreground hidden size-9 items-center justify-center rounded-md transition-colors sm:inline-flex"
        aria-label="Print CV"
        title="Print CV"
      >
        <Icon name="printer" />
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  document
    .querySelector('[data-print-page]')
    ?.addEventListener('click', () => window.print());
</script>
