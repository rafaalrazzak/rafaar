---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className } = Astro.props;
---

<section id={id} data-reveal class:list={['scroll-mt-20', className]}>
  <h2
    class="text-muted-foreground mb-4 text-sm font-medium print:mb-3 print:text-[0.7rem] print:font-semibold print:uppercase print:tracking-[0.18em]"
  >
    {title}
  </h2>
  <slot />
</section>
