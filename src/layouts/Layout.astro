---
import '@/styles/globals.css';
import siteMetadata from '@/data/site-metadata';
import Header from '@/components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteMetadata.SITE_NAME} — ${siteMetadata.SITE_TAGLINE}`,
  description = siteMetadata.SITE_DESCRIPTION,
} = Astro.props;

const ogImage = new URL(siteMetadata.TWITTER_CARD, siteMetadata.SITE_URL).href;
const canonical = new URL(Astro.url.pathname, siteMetadata.SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Resolve the theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const choice = saved === 'light' || saved === 'dark' ? saved : 'system';
        const dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);

        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themeChoice = choice;
        document.documentElement.classList.add('js');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.SITE_AUTHOR} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="color-scheme" content="light dark" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f6fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0e1d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.SITE_NAME} />
    <meta property="og:locale" content={siteMetadata.SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteMetadata.SITE_NAME}, ${siteMetadata.SITE_TAGLINE.toLowerCase()} in Bogor, Indonesia`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteMetadata.TWITTER_USERNAME} />
    <meta name="twitter:creator" content={siteMetadata.TWITTER_USERNAME} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteMetadata.SITE_NAME}, ${siteMetadata.SITE_TAGLINE.toLowerCase()} in Bogor, Indonesia`} />
  </head>
  <body>
    <a
      href="#content"
      class="bg-background ring-ring fixed left-4 top-4 print:hidden z-50 -translate-y-20 rounded-md border border-border px-3 py-2 text-sm font-medium transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="content"
      class="mx-auto w-full max-w-2xl px-5 pb-20 pt-10 sm:px-6 sm:pt-16"
    >
      <!-- Print frame. Browsers repeat a table's thead and tfoot on every
           printed page, so these spacer rows give each page its top and
           bottom padding whatever margins the print dialog is set to. On
           screen the table collapses to plain blocks. -->
      <table class="print-frame" role="presentation">
        <thead aria-hidden="true">
          <tr><td><div class="print-frame-top"></div></td></tr>
        </thead>
        <tbody>
          <tr><td><slot /></td></tr>
        </tbody>
        <tfoot aria-hidden="true">
          <tr>
            <td>
              <div class="print-frame-bottom">
                {siteMetadata.SITE_NAME} · {new URL(siteMetadata.SITE_URL).host}
              </div>
            </td>
          </tr>
        </tfoot>
      </table>
    </main>
    <footer class="text-muted-foreground mx-auto flex w-full max-w-2xl items-center justify-between px-5 pb-10 text-xs sm:px-6 print:hidden">
      <span>© {new Date().getFullYear()} {siteMetadata.SITE_NAME}</span>
      <a href="#content" class="hover:text-foreground">Back to top ↑</a>
    </footer>
  </body>
</html>
