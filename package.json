{
  "name": "@rafaar/site",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "oxfmt --write \"src/**/*.{ts,js,mjs,json,jsonc}\" \"*.{js,mjs,json,jsonc}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,js,mjs,json,jsonc}\" \"*.{js,mjs,json,jsonc}\"",
    "lint": "oxlint .",
    "deploy": "bun run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
